# ========================================
# iFlow 飞书助手 配置文件
# ========================================
# 复制此文件为 .env 并填入你的配置
# cp .env.feishu.example .env

# ----------------------------------------
# 飞书应用配置（必填）
# ----------------------------------------
# 获取方式：登录飞书开放平台
# https://open.feishu.cn/

# 应用 App ID：开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=你的飞书AppID

# 应用 App Secret：开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_SECRET=你的飞书AppSecret

