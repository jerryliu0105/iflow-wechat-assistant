# ========================================
# iFlow 飞书助手 配置文件
# ========================================
# 复制此文件为 .env 并填入你的配置
# cp .env.feishu.example .env

# ----------------------------------------
# 飞书应用配置（必填）
# ----------------------------------------
# 获取方式：登录飞书开放平台
# https://open.feishu.cn/

# 应用 App ID：开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=你的飞书AppID

# 应用 App Secret：开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_SECRET=你的飞书AppSecret

# ----------------------------------------
# iFlow CLI permissions (optional)
# ----------------------------------------
# IFLOW_ALL_FILES=true
# IFLOW_SANDBOX=false
# IFLOW_YOLO=false
# IFLOW_INCLUDE_DIRECTORIES=E:\,C:\Users\Administrator\Documents
# IFLOW_LOCAL_ALLOWLIST=E:\,C:\Users\Administrator\Documents
# IFLOW_PROMPT_PREFIX=继续当前任务，默认基于已有上下文直接执行，不要重复从头分析项目。用户指令：
