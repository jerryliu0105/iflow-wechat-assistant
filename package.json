{
  "name": "iflow-wechat-assistant",
  "version": "1.0.0",
  "description": "通过企业微信远程控制 iFlow CLI，支持连续对话，随时随地用手机操控 AI 编程助手",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
