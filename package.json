  "repository": {
    "type": "git",
    "url": "https://github.com/wx7in8/iflow-wechat-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/wx7in8/iflow-wechat-assistant/issues"
  },
  "homepage": "https://github.com/wx7in8/iflow-wechat-assistant#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
