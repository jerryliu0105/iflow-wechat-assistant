# ========================================
# iFlow 企业微信助手 配置文件
# ========================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ----------------------------------------
# 企业微信配置（必填）
# ----------------------------------------
# 获取方式：登录企业微信管理后台
# https://work.weixin.qq.com/wework_admin/frame

# 企业 ID：管理后台 → 我的企业 → 企业信息
CORP_ID=你的企业ID

# 应用 ID 和密钥：管理后台 → 应用管理 → 你的应用
AGENT_ID=你的应用AgentId
SECRET=你的应用Secret

# 你的用户账号：企业微信 App → 我 → 头像 → 账号
USER_ID=你的用户账号

# ----------------------------------------
# 服务配置（可选）
# ----------------------------------------

# 服务监听端口，默认 3000
PORT=3000

# ----------------------------------------
# iFlow CLI permissions (optional)
# ----------------------------------------
# IFLOW_ALL_FILES=true
# IFLOW_SANDBOX=false
# IFLOW_YOLO=false
# IFLOW_INCLUDE_DIRECTORIES=E:\,C:\Users\Administrator\Documents
# IFLOW_LOCAL_ALLOWLIST=E:\,C:\Users\Administrator\Documents
# IFLOW_PROMPT_PREFIX=

# ----------------------------------------
# 消息回调配置（配置接收消息后填写）
# ----------------------------------------
# 在企业微信后台 → 应用管理 → 接收消息 → 设置 API 接收
# 填写 URL 后，设置 Token 和随机生成 EncodingAESKey

# Token：自定义字符串，如 mytoken123
RECEIVE_TOKEN=

# EncodingAESKey：点击「随机获取」按钮生成
RECEIVE_ENCODING_AES_KEY=

# ----------------------------------------
# 域名验证配置（配置可信域名时填写）
# ----------------------------------------
# 设置可信域名时，企业微信会要求验证域名所有权
# 下载验证文件后，将文件名和内容填入下方

# 验证文件名，如：WW_verify_4fuuqQa3qNKYD47B.txt
WW_VERIFY_FILENAME=

# 验证文件内容，打开验证文件复制内容
WW_VERIFY_CONTENT=
